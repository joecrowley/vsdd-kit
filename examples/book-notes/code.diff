+import '../book.dart';
+import '../book_repository.dart';
+import '../result.dart';
+
+final class UpdateBookNotes {
+  const UpdateBookNotes(this._repository);
+
+  final BookRepository _repository;
+
+  Future<Result<Book>> call(BookId id, String notes) =>
+      _repository.updateNotes(id, notes);
+}
