schema: visual-driven

# Project keys the OpenSpec CLI reads (any other key, e.g. `prompts:`, is silently ignored):
#   context     - injected into every artifact                          (OpenSpec >= 1.2)
#   rules       - per-artifact constraints                              (OpenSpec >= 1.2)
#   operations  - advisory guidance for the apply / archive workflows   (newer OpenSpec, e.g. 1.13;
#                 older versions ignore it, which is harmless)
# Verify:
#   openspec instructions diagrams --change <name>          -> <project_context> and <rules> blocks
#   openspec instructions archive  --change <name> --json   -> "operationGuidance" (newer OpenSpec)

# Injected into every artifact. Keep it short: stack, layout, key conventions.
context: |
  <PROJECT_NAME>: <one-sentence description>.
  Stack: <languages, frameworks, state management, backend, infra>.
  Layout: <top-level modules/packages and what they own>.
  Conventions: <error handling, DI, testing, naming - only the ones agents get wrong>.

# Per-artifact constraints. The `diagrams` rules are part of VSDD - keep them.
# Add project rules to the other artifacts as needed.
rules:
  proposal:
    - "List every module/package the change touches in the Impact section."
  diagrams:
    - "Read `docs/VSDD.md` and `docs/MERMAID_RULES.md` before drafting any diagram."
    - "For a YES gate, add a `## Placement` table (Stable name | Source of Truth file | Action: update, add, move from <old file>, remove | Why here). Diagrams belong to the capability whose behaviour they show: when the change creates a capability, its new flows go in specs/<capability>/diagrams.md. A row that adds or moves a diagram into specs/architecture/diagrams.md must say in `Why here` which capabilities it spans."
    - "Copy the Before State verbatim from the file each Placement row names (for a move, the old file); copy only the affected stable-named sections."
    - "Keep stable section names unchanged when modifying an existing diagram - the archive merge targets sections by name."
    - "If no visual concern is affected, record NO with a one-line reason and omit Before/After sections."
  tasks:
    - "If diagrams.md has a YES gate, the final task group MUST include: trace the After State against the code and record any Deviations, then run python3 scripts/vsdd/validate_mermaid.py."

# VSDD backstop: delivered by the CLI to the stock apply/archive skills, so the key
# diagram steps still happen if `openspec update` has wiped the skill overlay.
operations:
  apply:
    guidance:
      - "VSDD: if the change's diagrams.md has a YES gate, before finishing trace every participant, node and edge in its After State against the code. Where the code differs, update the After State to match and add a top-level `## Deviations` section (Proposed / Built / Why)."
  archive:
    guidance:
      - "VSDD: before moving the change to the archive, merge its diagrams.md into the Source of Truth: run python3 scripts/vsdd/merge_diagrams.py <change dir> (with --dry-run first). Without the script, apply every row of its `## Placement` table as described in docs/VSDD.md section 4 (remove, move from <old file>, update, add). Skip if the gate is NO. Never touch sections without a Placement row, and never merge Before State, Placement or Deviations. Run python3 scripts/vsdd/validate_mermaid.py afterwards, and include a Diagrams line in the archive summary."
